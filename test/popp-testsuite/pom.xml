<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.gematik</groupId>
        <artifactId>testhub</artifactId>
        <version>3.22.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>de.gematik.ti20.popp</groupId>
    <artifactId>popp-testsuite</artifactId>

    <name>PoPP Testsuite</name>
    <description>Collection of E2E and IOP tests to validate PoPP-Service.</description>

    <properties>
        <popp.primSys.DocId>replace_me</popp.primSys.DocId>
        <popp.primSys.PharmId>replace_me</popp.primSys.PharmId>
        <popp.primSys.apikey>replace_me</popp.primSys.apikey>
        <skip.inttests>true</skip.inttests>
        <skip.unittests>false</skip.unittests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <dependency>
            <groupId>de.gematik.test</groupId>
            <artifactId>gem-testdata</artifactId>
        </dependency>
        <dependency>
            <groupId>de.gematik.test</groupId>
            <artifactId>tiger-test-lib</artifactId>
        </dependency>

        <dependency>
            <groupId>de.gematik.ti20.rbel</groupId>
            <artifactId>rbel-fluent-api</artifactId>
        </dependency>

        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-ensure</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.gematik</groupId>
            <artifactId>tiger-cloud-extension</artifactId>
            <version>${version.tiger-cloud-extension}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.gematik.ti20.popp</groupId>
            <artifactId>popp-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>de.gematik.test</groupId>
                <artifactId>tiger-maven-plugin</artifactId>
                <version>${version.tiger}</version>
                <executions>
                    <execution>
                        <id>generate-tiger-drivers</id>
                        <goals>
                            <goal>generate-drivers</goal>
                            <goal>attach-tiger-agent</goal>
                        </goals>
                        <phase>generate-test-sources</phase>
                        <configuration>
                            <glues>
                                <glue>de.gematik.test.tiger.glue</glue>
                                <glue>de.gematik.ti20.popp</glue>
                            </glues>
                            <skip>${skip.inttests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-tiger-report</id>
                        <goals>
                            <goal>generate-serenity-reports</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.maven.surefire}</version>
                <configuration>
                    <includes>
                        <include>**/PoPPClientIT.java</include>
                        <include>**/PoPPServerIT.java</include>
                    </includes>
                    <skipTests>${skip.unittests}</skipTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${version.maven.failsafe}</version>
                <configuration>
                    <forkedProcessExitTimeoutInSeconds>18000</forkedProcessExitTimeoutInSeconds>
                    <includes>
                        <include>**/Driver*IT.java</include>
                    </includes>
                    <skipITs>${skip.inttests}</skipITs>
                    <!-- Die Root-tiger.yaml explizit festnageln (wie in zeta-/vsdm-testsuite).
                         Ohne das sucht Tiger sie ausgehend vom Arbeitsverzeichnis nach oben,
                         was den Lauf vom CWD abhaengig macht. -->
                    <environmentVariables>
                        <TIGER_TESTENV_CFGFILE>${maven.multiModuleProjectDirectory}/tiger.yaml</TIGER_TESTENV_CFGFILE>
                        <TIGER_ROOTFOLDER>${maven.multiModuleProjectDirectory}</TIGER_ROOTFOLDER>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>intern</id>
            <!-- Robot-Tests brauchen interne Artefakte; robot/ fehlt im GitHub-Export (.githubignore) -->
            <activation>
                <file>
                    <exists>${basedir}/src/test/java/de/gematik/ti20/popp/robot</exists>
                </file>
            </activation>

            <dependencies>
                <dependency>
                    <groupId>de.gematik</groupId>
                    <artifactId>tiger-konnektor-management-extensions</artifactId>
                    <version>1.3.5</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>de.gematik</groupId>
                    <artifactId>tiger-robot-extension</artifactId>
                    <version>1.1.1</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>de.gematik</groupId>
                    <artifactId>WebsocketTester</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <scope>test</scope>
                    <exclusions>
                        <!-- konkurriert mit Logback; Spring Boot (Tiger, erp) bricht sonst beim Start ab -->
                        <exclusion>
                            <groupId>org.slf4j</groupId>
                            <artifactId>slf4j-simple</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
