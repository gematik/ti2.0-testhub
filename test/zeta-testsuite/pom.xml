<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0                              http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.gematik</groupId>
        <artifactId>testhub</artifactId>
        <version>3.24.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>zeta-testsuite</artifactId>
    <packaging>jar</packaging>

    <name>ZeTA Testsuite</name>
    <description>Collection of E2E and IT tests to validate ZeTA components (PEP, PDP, Ingress).</description>

    <properties>
        <polarion.auth.password>${polarion.pat}</polarion.auth.password>
        <polarion.auth.username>${polarion.username}</polarion.auth.username>
        <polarion.project>Mainline_OPB1</polarion.project>
        <polarion.testrun>ZETA_GEMATIK</polarion.testrun>
        <skip.inttests>true</skip.inttests>
        <zeta.polarion.output.dir>${project.build.directory}/polarion</zeta.polarion.output.dir>
        <zeta.testsuite.path>${maven.multiModuleProjectDirectory}/test/zeta-testsuite</zeta.testsuite.path>
    </properties>

    <!-- ========================================================= -->
    <!-- Dependencies                                              -->
    <!-- ========================================================= -->
    <dependencies>

        <!-- Nimbus JOSE JWT für JWT-Handling in Tests -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${version.nimbus-jose-jwt}</version>
        </dependency>

        <!-- Tiger Cloud Extension für Docker-Support -->
        <dependency>
            <groupId>de.gematik</groupId>
            <artifactId>tiger-cloud-extension</artifactId>
        </dependency>
        <!-- Tiger Test Library (bringt Cucumber + Serenity Glue mit) -->
        <dependency>
            <groupId>de.gematik.test</groupId>
            <artifactId>tiger-test-lib</artifactId>
        </dependency>
        <dependency>
            <groupId>de.gematik.ti20.rbel</groupId>
            <artifactId>rbel-fluent-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.28.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ========================================================= -->
    <!-- Build                                                      -->
    <!-- ========================================================= -->
    <build>
        <plugins>

            <plugin>
                <groupId>de.gematik.test</groupId>
                <artifactId>tiger-maven-plugin</artifactId>
                <version>${version.tiger}</version>
                <executions>
                    <execution>
                        <id>generate-tiger-drivers</id>
                        <goals>
                            <goal>generate-drivers</goal>
                            <goal>attach-tiger-agent</goal>
                        </goals>
                        <phase>generate-test-sources</phase>
                        <configuration>
                            <glues>
                                <glue>de.gematik.test.tiger.glue</glue>
                                <glue>de.gematik.zeta</glue>
                            </glues>
                            <skip>${skip.inttests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-tiger-report</id>
                        <goals>
                            <goal>generate-serenity-reports</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TIGER_TESTENV_CFGFILE>${maven.multiModuleProjectDirectory}/tiger.yaml</TIGER_TESTENV_CFGFILE>
                        <TIGER_ROOTFOLDER>${maven.multiModuleProjectDirectory}</TIGER_ROOTFOLDER>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- ========================================================= -->
    <!-- Profiles                                                     -->
    <!-- ========================================================= -->
    <profiles>
        <profile>
            <id>jenkins-build</id>
            <activation>
                <property>
                    <name>env.POLARION_CREDENTIALS_PSW</name>
                </property>
            </activation>
            <properties>
                <polarion.auth.password>${env.POLARION_CREDENTIALS_PSW}</polarion.auth.password>
                <polarion.auth.username>${env.POLARION_CREDENTIALS_USR}</polarion.auth.username>
            </properties>
        </profile>
        <profile>
            <id>polarion-parse</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>de.gematik</groupId>
                        <artifactId>gematik-polarion-maven-plugin</artifactId>
                        <version>3.1.1-224</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>parse-bdd</goal>
                                </goals>
                                <configuration>
                                    <pathToBddFiles>${zeta.testsuite.path}/src/test/resources/features</pathToBddFiles>
                                    <fileExtension>.feature</fileExtension>
                                    <destinationFilePath>${zeta.polarion.output.dir}/zeta-testcases.json</destinationFilePath>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>polarion-sync</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>de.gematik</groupId>
                        <artifactId>gematik-polarion-maven-plugin</artifactId>
                        <version>3.1.1-224</version>
                        <executions>
                            <execution>
                                <id>sync</id>
                                <goals>
                                    <goal>sync-testcases</goal>
                                </goals>
                                <phase>install</phase>
                                <configuration>
                                    <polarionUrl>${polarion.url}</polarionUrl>
                                    <username>${polarion.auth.username}</username>
                                    <password>${polarion.auth.password}</password>
                                    <project>${polarion.project}</project>
                                    <luceneQuery>cfInternalId:ZETA_*</luceneQuery>
                                    <jsonFilePath>${zeta.testsuite.path}/target/polarion/zeta-testcases.json</jsonFilePath>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>polarion-upload</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>de.gematik</groupId>
                        <artifactId>gematik-polarion-maven-plugin</artifactId>
                        <version>3.1.1-224</version>
                        <executions>
                            <execution>
                                <id>upload</id>
                                <goals>
                                    <goal>upload-testresults</goal>
                                </goals>
                                <phase>post-integration-test</phase>
                                <configuration>
                                    <username>${polarion.auth.username}</username>
                                    <password>${polarion.auth.password}</password>
                                    <project>${polarion.project}</project>
                                    <testRun>${polarion.testrun}</testRun>
                                    <serenityReportsFolderPath>${zeta.testsuite.path}/target/site/serenity</serenityReportsFolderPath>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
